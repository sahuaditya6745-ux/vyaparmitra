# PragatiSahayak Environment Variables Example
# Copy this file to .env or .env.local to configure

# Set to your Flask or FastAPI backend URL when ready.
# When empty or omitted, PragatiSahayak runs seamlessly using the built-in mock data layer.
VITE_API_URL=http://localhost:5000/api

# Optional LLM API Key (e.g. Google Gemini API) for custom live AI inference
VITE_LLM_API_KEY=your_key_here
